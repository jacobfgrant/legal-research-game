# Domains default to localhost ports. Set environment variables for production:
#   CASE_CRAWLER_DOMAIN=casecrawler.yourdomain.com
#   THE_BRIEF_DOMAIN=thebrief.yourdomain.com
# Caddy handles HTTPS automatically when using a real domain.

{$CASE_CRAWLER_DOMAIN::8080} {
	handle /api/* {
		reverse_proxy case-crawler-backend:8000
	}
	handle {
		reverse_proxy case-crawler-frontend:3000
	}
}

{$THE_BRIEF_DOMAIN::8081} {
	handle /api/* {
		reverse_proxy the-brief-backend:8000
	}
	handle {
		reverse_proxy the-brief-frontend:3000
	}
}
